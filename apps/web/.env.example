# Base URL of the backend API.
#
# This is the ONLY variable the web app takes, and it deliberately holds
# nothing secret: everything in a Vite bundle is public, so any value here is
# readable by anyone who loads the page. Keeping the provider credential out
# of the browser is the entire reason the backend exists.
#
# Leave unset to use the default below, which is the cross-origin case the
# backend's CORS allowlist is configured for.
VITE_API_BASE_URL=http://localhost:3000
