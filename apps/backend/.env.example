APP_PORT=3000
NODE_ENV=development
APP_STAGE=dev

# --- Auth --------------------------------------------------------------------
# bcrypt cost factor.
SALT_ROUNDS=10
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-secret
JWT_ISSUER=ai-query-assistant
JWT_AUDIENCE=ai-query-assistant-web
JWT_EXPIRES_IN=15m

# --- LLM provider ------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Never commit the real value; this file holds placeholders only.
GEMINI_API_KEY=replace-me-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-flash-latest
# Abort a single provider call after this many milliseconds.
LLM_TIMEOUT_MS=20000
# Authoritative prompt cap. The web app mirrors this for instant feedback, but
# only this value is enforced.
LLM_MAX_PROMPT_CHARS=4000

# --- HTTP --------------------------------------------------------------------
# Browser origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:3020
