APP_PORT=3000
NODE_ENV=development
APP_STAGE=dev
# How long a SIGTERM'd process may spend draining in-flight requests before it
# gives up and exits. Keep this BELOW the orchestrator's own grace period
# (Docker: 10s, ECS stopTimeout: 30s) or it has no effect — the orchestrator
# would SIGKILL first.
SHUTDOWN_TIMEOUT_MS=8000
# How long the process keeps accepting connections AFTER /ready starts
# answering 503, before it stops listening. Separating "stop being advertised"
# from "stop accepting" is what makes readiness readable during a drain: close
# the listener in the same tick and a poller gets a refused connection instead
# of the 503. Must stay below SHUTDOWN_TIMEOUT_MS (enforced at boot).
# Unnecessary on ECS, where the target is deregistered before SIGTERM; it is
# the whole mechanism on Kubernetes.
READINESS_DRAIN_MS=1000

# --- Auth --------------------------------------------------------------------
# bcrypt cost factor, used by scripts/hash-password.ts.
SALT_ROUNDS=10
# The single demo identity. No database, no registration — the brief asks for
# a protected endpoint, not user management.
DEMO_USER_EMAIL=demo@example.com
# Base64-encoded bcrypt hash — never a plaintext password, and never the raw
# hash either. A bcrypt hash is `$2b$10$...`, and Bun's dotenv loader expands
# `$VAR` here whatever the quoting, so a raw hash silently arrives truncated
# and every login fails. Base64 survives Bun's loader, Docker's --env-file and
# an injected secret unchanged. Generate with:
#   bun run scripts/hash-password.ts '<password>'
# The value below is a REAL, WORKING hash of the documented demo password
# `demo-password`, so a reviewer can copy this file and log in immediately.
# That is safe precisely because the password is public: what is being
# demonstrated is that config holds a hash and login does a bcrypt compare,
# which a published demo credential does not weaken.
DEMO_USER_PASSWORD_HASH_B64=JDJiJDEwJDFrOS9jZUFUQ2NGdGVtcE92azFWUC5jWVJTbFJieVRJRjZ2SVl6UVkuNHVYVlN0d2RKTEdt
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-characters-of-secret
JWT_ISSUER=ai-query-assistant
JWT_AUDIENCE=ai-query-assistant-web
JWT_EXPIRES_IN=15m

# --- LLM provider ------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Never commit the real value; this file holds placeholders only.
GEMINI_API_KEY=replace-me-with-your-google-ai-studio-key
# A pinned id, deliberately not the `gemini-flash-latest` alias: measured
# repeatedly on 2026-10-26, that alias failed every call (503, then 429) while
# pinned ids answered, and it is what made a fresh clone's first query fail.
#
# Capacity is a provider-side condition, so if you get LLM_UNAVAILABLE (502)
# or LLM_RATE_LIMITED (429) on every query, change this value before looking
# anywhere else — `gemini-3.5-flash` is the known-good fallback. That it is a
# config change and not a code change is the reason it is a variable.
GEMINI_MODEL=gemini-2.5-flash
# `gemini` calls the real API; `fake` serves deterministic canned answers and
# makes every error state reachable from a prompt prefix (!empty, !blocked,
# !timeout, !ratelimit, !unavailable, !truncated) without spending tokens.
# Refused at boot when APP_STAGE=prod.
LLM_PROVIDER=gemini
# Abort a single provider call after this many milliseconds.
LLM_TIMEOUT_MS=20000
# Authoritative prompt cap. The web app mirrors this for instant feedback, but
# only this value is enforced.
LLM_MAX_PROMPT_CHARS=4000

# --- HTTP --------------------------------------------------------------------
# Browser origins allowed to call this API (comma-separated).
CORS_ORIGINS=http://localhost:3020
