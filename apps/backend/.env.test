# Deterministic configuration for `bun test`.
#
# Bun loads this file when NODE_ENV=test, which `bun test` sets, so the suite
# runs identically on a clean clone with no local .env at all. Every value
# here is a placeholder: the tests exercise the provider seam through the fake
# adapter and never make a network call. Committing it is safe for the same
# reason — there is no secret in it.
NODE_ENV=test
APP_STAGE=dev
JWT_SECRET=test-only-secret-at-least-32-characters-long
JWT_ISSUER=ai-query-assistant
JWT_AUDIENCE=ai-query-assistant-web
JWT_EXPIRES_IN=15m
# Lowered from the production default purely for test speed: bcrypt at cost 10
# is ~100ms per hash by design, which is the right number in production and
# the wrong one multiplied across a suite.
SALT_ROUNDS=4
DEMO_USER_EMAIL=demo@example.com
# bcrypt hash of `demo-password` at cost 4, matching SALT_ROUNDS above.
DEMO_USER_PASSWORD_HASH_B64=JDJiJDA0JEFRdjBscVdaQ3gxSGZiRUV0cGkxTi4uRFRoQkxNbnFBQjFWSXQ5bkFEaHNnUWNXdTA3ZjYu
GEMINI_API_KEY=test-only-placeholder-never-called
GEMINI_MODEL=gemini-flash-latest
LLM_TIMEOUT_MS=20000
LLM_MAX_PROMPT_CHARS=4000
CORS_ORIGINS=http://localhost:3020
